# Copy to .env and fill in real values

# ---------- Database (Supabase Postgres) ----------
# Pooled connection (transaction mode, port 6543) — used by the app at runtime
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string → Prisma
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by `prisma migrate` / `prisma db push`
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ---------- Public app URL ----------
# Used to render webhook URLs in /integrations. Set to your prod domain when deployed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
